# Aa file ne copy kari ne ".env" naam aapo, ane tamari keys bharo.
# Darek brand na accounts alag chhe, etle darek key ni aagal brand nu prefix chhe
# (config.json ma 'env_prefix'). Je platform vaparvu nathi tenu khali rehva do.

# --- AI — ochha ma ochhi EK bharo. FREE vala pehla vaparay chhe. ---
# FREE: https://aistudio.google.com → Get API key
GEMINI_API_KEY=
# FREE: https://console.groq.com → API Keys
GROQ_API_KEY=
# FREE, tamara computer par: https://ollama.com install karo, pachhi "ollama pull gemma3:12b"
OLLAMA_URL=http://localhost:11434
# PAID (optional, chhello vikalp): https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Meta (Facebook + Instagram) — EK J token thi BADHA Page ane Instagram ---
# developers.facebook.com → Graph API Explorer → User token (pages_show_list, pages_manage_posts,
# pages_read_engagement, instagram_basic, instagram_content_publish) → Long-lived banavo.
# Pachhi chalavo: python main.py --accounts
META_USER_TOKEN=
META_APP_ID=
META_APP_SECRET=

# --- YouTube (App → 🔗 Jodo thi bharay chhe) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Kahani/Cartoon video na chitra (optional): https://enter.pollinations.ai — key hoy to jadapi + watermark nahi ---
POLLINATIONS_API_KEY=

# --- Instagram/Pinterest mate media link — app JATE free hosting (litterbox, 24 kalak) par muke chhe ---
# Potani website hoy to (optional): https://mysite.com/output
PUBLIC_IMAGE_BASE_URL=
# Vadhu bharosapatra (optional): cloudinary.com free account + config.json ma "media_host": "cloudinary"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- 🧑 Bolto chahero video (PAID, optional): https://app.heygen.com → Settings → API ---
HEYGEN_API_KEY=
# 🌾 Bija yard na bhav (Rajkot, Junagadh, Amreli, Jamnagar) — data.gov.in par sign up → API key (free)
DATA_GOV_IN_API_KEY=

# --- PC par pan PIN (optional; PC bija vapre to) ---
APP_PC_PIN=

# --- App PIN (mobile/server mate; 8+ akshar — dakhla Kheti@Gondal2026; server mode ma 10+ farjiyat) ---
APP_PIN=
# Online server: tamaru domain (Cloudflare Tunnel) ane tunnel token
APP_HOSTS=
TUNNEL_TOKEN=

# --- AI Doctor: bhul aave to phone par Telegram ma khabar (optional) ---
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# ================= Khedut Putra (KHEDUT_) =================
KHEDUT_FB_PAGE_ID=
KHEDUT_FB_PAGE_ACCESS_TOKEN=
KHEDUT_IG_USER_ID=
KHEDUT_IG_ACCESS_TOKEN=
KHEDUT_PUBLIC_IMAGE_BASE_URL=
KHEDUT_THREADS_USER_ID=
KHEDUT_THREADS_ACCESS_TOKEN=
KHEDUT_X_API_KEY=
KHEDUT_X_API_SECRET=
KHEDUT_X_ACCESS_TOKEN=
KHEDUT_X_ACCESS_SECRET=
KHEDUT_LINKEDIN_ACCESS_TOKEN=
KHEDUT_LINKEDIN_AUTHOR_URN=
KHEDUT_PINTEREST_ACCESS_TOKEN=
KHEDUT_PINTEREST_BOARD_ID=
KHEDUT_TELEGRAM_BOT_TOKEN=
KHEDUT_TELEGRAM_CHAT_ID=
KHEDUT_YOUTUBE_ACCESS_TOKEN=

# ================= Chiron Enterprise (CHIRON_) =================
CHIRON_FB_PAGE_ID=
CHIRON_FB_PAGE_ACCESS_TOKEN=
CHIRON_IG_USER_ID=
CHIRON_IG_ACCESS_TOKEN=
CHIRON_PUBLIC_IMAGE_BASE_URL=
CHIRON_THREADS_USER_ID=
CHIRON_THREADS_ACCESS_TOKEN=
CHIRON_X_API_KEY=
CHIRON_X_API_SECRET=
CHIRON_X_ACCESS_TOKEN=
CHIRON_X_ACCESS_SECRET=
CHIRON_LINKEDIN_ACCESS_TOKEN=
CHIRON_LINKEDIN_AUTHOR_URN=
CHIRON_PINTEREST_ACCESS_TOKEN=
CHIRON_PINTEREST_BOARD_ID=
CHIRON_TELEGRAM_BOT_TOKEN=
CHIRON_TELEGRAM_CHAT_ID=
CHIRON_YOUTUBE_ACCESS_TOKEN=


# Navo brand App ma "➕ Navo brand" thi banavo — eni key App → 🔗 Jodo thi bharay chhe (prefix B1_, B2_ ...).
# Atyar na box na prefix: B3_ Bhavesh Thummar · B4_ Labour and Manpower Supply · B5_ Scrap · B6_ Saitica ·
# B7_ Gujarat Agri Business · B8_ Import Export · B9_ Movie Hub · B10_ Khodal Dham · B11_ Phone Zone ·
# B12_ Cartoon YouTube · B13_ Cricket · B14_ Our Gujarat News   (dakhla: B9_FB_PAGE_ID=..., B9_IG_USER_ID=...)
# (Juno Khedut News B1_ hato — eni setting khedut_news_backup.json ma sachvi chhe.)
